# FlowDesk landing — environment configuration (EXAMPLE)
# Copy to `.env.local` and adjust if your API runs somewhere other than the
# local-dev default. NOT required for local dev (the default below is used).

# Base URL of the FlowDesk API that serves the Discord OAuth login.
# The "Login with Discord" CTA points at `${NEXT_PUBLIC_API_BASE_URL}/api/auth/discord/login`.
# Default (when unset): http://localhost:8000  — matches PUBLIC_BASE_URL in the repo root .env.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
