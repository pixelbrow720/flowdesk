---
import { HONESTY_LEDGER } from '../lib/data.ts';
---

<section id="honesty" class="honesty" data-section="honesty">
  <div class="container">
    <header class="honesty__hd">
      <span class="exhibit-tag">EXHIBIT E · HONESTY LEDGER</span>
      <h2 class="honesty__title">The receipts. Public.</h2>
      <p class="honesty__lede">
        Every claim FlowDesk makes maps to a status. Production claims are
        golden-fixture-locked. Research claims surface in product behind a
        <span class="warn-tag">NOT-VALIDATED</span> tag, never silently.
      </p>
    </header>

    <table class="ledger">
      <thead>
        <tr>
          <th scope="col" class="label">Claim</th>
          <th scope="col" class="label">Status</th>
          <th scope="col" class="label">Note</th>
        </tr>
      </thead>
      <tbody>
        {HONESTY_LEDGER.map((row) => (
          <tr class={`ledger__row ledger__row--${row.status.toLowerCase().replace(/[^a-z]/g, '')}`}>
            <td class="ledger__claim">{row.claim}</td>
            <td class="ledger__status mono">{row.status}</td>
            <td class="ledger__note">{row.note}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
</section>

<style>
  .honesty {
    padding-block: var(--section-y);
    background: var(--bg);
    border-bottom: 1px solid var(--rule);
  }
  .honesty__hd { max-width: 64ch; display: flex; flex-direction: column; gap: 1rem; margin-bottom: clamp(2.5rem, 6vh, 4rem); }
  .honesty__title {
    font-size: var(--fs-h2);
    line-height: var(--lh-snug);
    letter-spacing: var(--tracking-tight);
    font-weight: 500;
  }
  .honesty__lede { color: var(--ink-80); line-height: 1.55; }

  .ledger {
    width: 100%;
    border-collapse: collapse;
    font-size: var(--fs-body);
  }
  .ledger th,
  .ledger td {
    padding: 1rem 1rem 1rem 0;
    text-align: left;
    border-bottom: 1px solid var(--rule);
    vertical-align: top;
  }
  .ledger th { padding-block: 0.5rem 1rem; color: var(--fg-mute); }
  .ledger__claim { color: var(--ink-100); font-weight: 500; }
  .ledger__status { font-size: var(--fs-mono-sm); letter-spacing: var(--tracking-label); }
  .ledger__note { color: var(--ink-80); font-size: 0.95rem; max-width: 50ch; }

  .ledger__row--production .ledger__status,
  .ledger__row--locked .ledger__status,
  .ledger__row--breakingok .ledger__status { color: var(--turquoise); }
  .ledger__row--notvalidated .ledger__status { color: var(--warn); }
  .ledger__row--gated .ledger__status { color: var(--crimson-l); }

  @media (max-width: 720px) {
    .ledger,
    .ledger thead,
    .ledger tbody,
    .ledger tr,
    .ledger th,
    .ledger td { display: block; }
    .ledger thead { display: none; }
    .ledger__row { padding-block: 1rem; border-bottom: 1px solid var(--rule); }
    .ledger td { padding: 0.25rem 0; border: 0; }
  }
</style>
