---
import { LENSES } from '../lib/data.ts';
---

<section id="lenses" class="lenses" data-section="lenses">
  <div class="container">
    <header class="lenses__hd">
      <span class="exhibit-tag">EXHIBIT C · LENSES</span>
      <h2 class="lenses__title">Seven instruments. Three of them experimental.</h2>
      <p class="lenses__lede">
        Each lens reads the same snapshot through a different math. Production
        lenses are golden-fixture-locked. Research lenses are tagged
        <span class="warn-tag">NOT-VALIDATED</span> in product and on this page.
      </p>
    </header>

    <div class="lenses__grid">
      {LENSES.map((l, i) => (
        <article class={`lens lens--${l.status === 'PRODUCTION' ? 'prod' : 'research'}`} data-anim="lens-card" style={`--i:${i}`}>
          <header class="lens__hd">
            <span class="lens__key mono">{l.key}</span>
            {l.status === 'NOT-VALIDATED' && <span class="warn-tag">NOT-VALIDATED</span>}
          </header>
          <h3 class="lens__title">{l.title}</h3>
          <p class="lens__sub label">{l.subtitle}</p>
          <p class="lens__body">{l.body}</p>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .lenses {
    padding-block: var(--section-y);
    background: var(--bg);
    border-bottom: 1px solid var(--rule);
  }
  .lenses__hd { max-width: 64ch; margin-bottom: clamp(2.5rem, 6vh, 5rem); display: flex; flex-direction: column; gap: 1rem; }
  .lenses__title {
    font-size: var(--fs-h2);
    line-height: var(--lh-snug);
    letter-spacing: var(--tracking-tight);
    font-weight: 500;
  }
  .lenses__lede { color: var(--ink-80); line-height: 1.55; }

  .lenses__grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 1px;
    background: var(--rule);
    border: 1px solid var(--rule);
  }
  .lens {
    background: var(--bg);
    padding: clamp(1.5rem, 3vw, 2.25rem);
    display: flex; flex-direction: column; gap: 0.75rem;
    transition: background var(--dur-med) var(--ease-out);
  }
  .lens:hover { background: var(--ground-2); }

  .lens__hd { display: flex; align-items: center; justify-content: space-between; gap: 1rem; }
  .lens__key {
    font-size: var(--fs-mono-xs);
    color: var(--fg-mute);
    letter-spacing: var(--tracking-label);
  }
  .lens--prod .lens__key { color: var(--crimson); }
  .lens__title {
    font-size: var(--fs-h3);
    letter-spacing: var(--tracking-tight);
    font-weight: 500;
    line-height: var(--lh-snug);
  }
  .lens__sub { color: var(--ink-80); }
  .lens__body { color: var(--ink-80); line-height: 1.55; }
</style>
