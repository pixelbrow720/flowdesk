---
---

<section id="pricing" class="pricing" data-section="pricing">
  <div class="container">
    <header class="pricing__hd">
      <span class="exhibit-tag">EXHIBIT H · PRICING</span>
      <h2 class="pricing__title">One tier. Visible. No sales call.</h2>
      <p class="pricing__lede">
        Beta is a single price. No usage gating, no seat math, no enterprise
        upsell. When you cancel you keep the data you exported. The honest
        deal is the deal.
      </p>
    </header>

    <div class="pricing__plan">
      <header class="plan__hd">
        <span class="label">Operator · Paid Beta</span>
        <span class="plan__price mono tabular">$<span class="plan__price-num">99</span><span class="plan__price-period">/month</span></span>
      </header>

      <ul class="plan__list">
        <li><span class="check" aria-hidden="true">✓</span> Full FLUX + FOG + LEVELS lenses (production)</li>
        <li><span class="check" aria-hidden="true">✓</span> Three research lenses, tagged honestly</li>
        <li><span class="check" aria-hidden="true">✓</span> Historical replay (paid beta scope)</li>
        <li><span class="check" aria-hidden="true">✓</span> Schema-versioned snapshot exports</li>
        <li class="muted"><span class="check muted" aria-hidden="true">·</span> Live feed gated behind public release</li>
        <li class="muted"><span class="check muted" aria-hidden="true">·</span> No Discord. No course. No upsell.</li>
      </ul>

      <a href="#access" class="btn btn--primary plan__cta">Request beta access</a>
    </div>
  </div>
</section>

<style>
  .pricing {
    padding-block: var(--section-y);
    background: var(--ground-2);
    border-bottom: 1px solid var(--rule);
  }
  .pricing__hd { max-width: 60ch; display: flex; flex-direction: column; gap: 1rem; margin-bottom: clamp(2.5rem, 6vh, 4rem); }
  .pricing__title {
    font-size: var(--fs-h2);
    line-height: var(--lh-snug);
    letter-spacing: var(--tracking-tight);
    font-weight: 500;
  }
  .pricing__lede { color: var(--ink-80); line-height: 1.55; }

  .pricing__plan {
    background: var(--bg);
    border: 1px solid var(--rule);
    padding: clamp(1.75rem, 4vw, 2.5rem);
    max-width: 540px;
  }
  .plan__hd { display: flex; align-items: baseline; justify-content: space-between; gap: 1rem; padding-bottom: 1.5rem; border-bottom: 1px solid var(--rule); margin-bottom: 1.5rem; }
  .plan__price { font-size: clamp(2rem, 4vw, 2.75rem); color: var(--ink-100); line-height: 1; }
  .plan__price-num { color: var(--crimson); }
  .plan__price-period { font-size: 0.5em; color: var(--fg-mute); margin-left: 0.25rem; }

  .plan__list { list-style: none; display: flex; flex-direction: column; gap: 0.75rem; margin-bottom: 2rem; color: var(--ink-80); }
  .plan__list li { display: flex; gap: 0.65rem; align-items: baseline; }
  .plan__list .check { color: var(--turquoise); font-family: var(--font-mono); flex-shrink: 0; }
  .plan__list .muted { color: var(--fg-mute); }
  .plan__list .check.muted { color: var(--ink-40); }

  .plan__cta { display: inline-block; }
</style>
