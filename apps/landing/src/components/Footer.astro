<footer class="foot">
  <div class="container foot__inner">
    <div class="foot__brand">
      <span class="foot__mark mono">FD</span>
      <div>
        <p class="foot__name">FlowDesk</p>
        <p class="label">Operator-grade options telemetry · v0.1 · schema_version 2</p>
      </div>
    </div>

    <ul class="foot__cols">
      <li>
        <span class="label">Product</span>
        <ul>
          <li><a href="#manifesto">Manifesto</a></li>
          <li><a href="#lenses">Lenses</a></li>
          <li><a href="#exhibit">Exhibit A</a></li>
          <li><a href="#pricing">Pricing</a></li>
        </ul>
      </li>
      <li>
        <span class="label">Trust</span>
        <ul>
          <li><a href="#honesty">Honesty ledger</a></li>
          <li><a href="#performance">Performance</a></li>
          <li><a href="#founder">Founder</a></li>
        </ul>
      </li>
      <li>
        <span class="label">Contact</span>
        <ul>
          <li><a href="#access">Beta access</a></li>
          <li><a href="mailto:hi@flowdesk.io">hi@flowdesk.io</a></li>
        </ul>
      </li>
    </ul>

    <p class="foot__legal label">
      © 2026 FlowDesk · Not investment advice · Built by one operator ·
      <a href="https://github.com/flowdesk">github</a>
    </p>
  </div>
</footer>

<style>
  .foot {
    padding-block: clamp(3rem, 8vh, 5rem);
    background: var(--ground-0);
    color: var(--ink-80);
  }
  .foot__inner { display: grid; gap: 2.5rem; grid-template-columns: 1fr; }

  .foot__brand { display: flex; align-items: center; gap: 0.75rem; }
  .foot__mark {
    width: 2.25rem; height: 2.25rem;
    display: grid; place-items: center;
    background: var(--crimson); color: var(--ink-100);
    font-weight: 700;
  }
  .foot__name { color: var(--ink-100); font-weight: 600; letter-spacing: var(--tracking-tight); }

  .foot__cols { list-style: none; display: grid; grid-template-columns: repeat(auto-fit, minmax(160px, 1fr)); gap: 2rem; }
  .foot__cols > li { display: flex; flex-direction: column; gap: 0.75rem; }
  .foot__cols ul { list-style: none; display: flex; flex-direction: column; gap: 0.5rem; }
  .foot__cols a { color: var(--ink-80); }
  .foot__cols a:hover { color: var(--crimson-l); }

  .foot__legal { padding-top: 1.5rem; border-top: 1px solid var(--rule); color: var(--fg-mute); }
  .foot__legal a { color: var(--ink-80); }
  .foot__legal a:hover { color: var(--crimson-l); }
</style>
