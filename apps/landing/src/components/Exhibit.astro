---
import { EXHIBIT_A } from '../lib/data.ts';

// Scale flux into bar widths for a small static visualization (no canvas, pure CSS).
const maxAbs = Math.max(...EXHIBIT_A.map((t) => Math.abs(t.flux)));
---

<section id="exhibit" class="exhibit" data-section="exhibit">
  <div class="container">
    <header class="exhibit__hd">
      <span class="exhibit-tag">EXHIBIT D · GOLDEN SNAPSHOT</span>
      <h2 class="exhibit__title">A real eight-minute trace. Frozen byte-for-byte in tests.</h2>
      <p class="exhibit__lede">
        Source: <span class="mono">services/engine/tests/golden/snapshot.golden.json</span>.
        Schema version 2. ES, June 10, 2026. Forward sliding from 5004 to 4997 while
        FLUX flips from <span class="pos">+3.41M</span> to <span class="neg">−3.22M</span>.
      </p>
    </header>

    <div class="exhibit__chart" role="img" aria-label="FLUX time series, 8 minutes, ES, June 10 2026">
      <ul class="bars tabular mono">
        {EXHIBIT_A.map((t) => {
          const pct = Math.round((Math.abs(t.flux) / maxAbs) * 100);
          const sign = t.flux >= 0 ? 'pos' : 'neg';
          return (
            <li class={`bar bar--${sign}`}>
              <span class="bar__time">{t.ts.slice(11, 16)}Z</span>
              <span class="bar__rail">
                <span class="bar__fill" style={`width:${pct}%`}></span>
              </span>
              <span class="bar__val">{(t.flux / 1_000_000).toFixed(2)}M</span>
            </li>
          );
        })}
      </ul>
    </div>

    <dl class="exhibit__meta">
      <div>
        <dt class="label">Schema version</dt>
        <dd class="mono">2</dd>
      </div>
      <div>
        <dt class="label">Engine tests</dt>
        <dd class="mono">415 / 415 passed</dd>
      </div>
      <div>
        <dt class="label">API tests</dt>
        <dd class="mono">116 / 116 passed</dd>
      </div>
      <div>
        <dt class="label">Mirror trio</dt>
        <dd class="mono">pydantic ↔ zod ↔ golden</dd>
      </div>
    </dl>
  </div>
</section>

<style>
  .exhibit {
    padding-block: var(--section-y);
    background: var(--ground-2);
    border-bottom: 1px solid var(--rule);
  }
  .exhibit__hd { max-width: 70ch; display: flex; flex-direction: column; gap: 1rem; margin-bottom: clamp(2rem, 5vh, 4rem); }
  .exhibit__title {
    font-size: var(--fs-h2);
    line-height: var(--lh-snug);
    letter-spacing: var(--tracking-tight);
    font-weight: 500;
  }
  .exhibit__lede { color: var(--ink-80); line-height: 1.55; }
  .exhibit__lede .mono { color: var(--ink-100); font-size: 0.95em; }
  .pos { color: var(--turquoise); }
  .neg { color: var(--crimson-l); }

  .exhibit__chart {
    background: var(--ground-0);
    padding: clamp(1.5rem, 4vw, 2.5rem);
    border: 1px solid var(--rule);
  }
  .bars { list-style: none; display: flex; flex-direction: column; gap: 0.5rem; font-size: var(--fs-mono-sm); }
  .bar {
    display: grid;
    grid-template-columns: 4.5rem 1fr 5rem;
    gap: 1rem;
    align-items: center;
  }
  .bar__time { color: var(--fg-mute); }
  .bar__rail {
    height: 1.4rem;
    background: var(--ground-4);
    position: relative;
    overflow: hidden;
  }
  .bar__fill {
    display: block;
    height: 100%;
    background: var(--turquoise);
  }
  .bar--neg .bar__fill { background: var(--crimson); }
  .bar__val { text-align: right; color: var(--ink-100); }
  .bar--neg .bar__val { color: var(--crimson-l); }
  .bar--pos .bar__val { color: var(--turquoise); }

  .exhibit__meta {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    gap: 1.5rem 2rem;
    margin-top: clamp(2rem, 5vh, 3rem);
    padding-top: 1.5rem;
    border-top: 1px solid var(--rule);
  }
  .exhibit__meta dt { margin-bottom: 0.25rem; }
  .exhibit__meta dd { color: var(--ink-100); font-size: 0.95rem; }
</style>
