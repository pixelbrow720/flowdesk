---
import { MANIFESTO } from '../lib/data.ts';
---

<section id="manifesto" class="manifesto" data-section="manifesto">
  <div class="container">
    <header class="manifesto__hd">
      <span class="exhibit-tag">EXHIBIT B · MANIFESTO</span>
      <h2 class="manifesto__title">Four things every operator already knows.</h2>
    </header>

    <ol class="manifesto__list" role="list">
      {MANIFESTO.map((m, i) => (
        <li class="manifesto__item" data-anim="manifesto-item" style={`--i:${i}`}>
          <span class="manifesto__num mono" aria-hidden="true">{m.n}</span>
          <div class="manifesto__body">
            <h3 class="manifesto__h3">{m.title}</h3>
            <p class="manifesto__p">{m.body}</p>
          </div>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .manifesto {
    padding-block: var(--section-y);
    background: var(--ground-2);
    border-bottom: 1px solid var(--rule);
  }
  .manifesto__hd { display: flex; flex-direction: column; gap: 1rem; margin-bottom: clamp(2.5rem, 6vh, 5rem); max-width: 32ch; }
  .manifesto__title {
    font-size: var(--fs-h2);
    line-height: var(--lh-snug);
    letter-spacing: var(--tracking-tight);
    font-weight: 500;
  }

  .manifesto__list {
    list-style: none;
    display: grid;
    gap: clamp(1.5rem, 4vh, 3rem);
  }
  .manifesto__item {
    display: grid;
    grid-template-columns: minmax(120px, 0.18fr) 1fr;
    gap: clamp(1rem, 4vw, 3rem);
    padding-top: 2rem;
    border-top: 1px solid var(--rule);
    align-items: start;
  }
  .manifesto__num {
    font-size: var(--fs-display);
    line-height: 0.85;
    font-weight: 300;
    color: var(--crimson);
    letter-spacing: -0.04em;
    font-feature-settings: 'tnum' 1;
  }
  .manifesto__h3 {
    font-size: var(--fs-h3);
    line-height: var(--lh-snug);
    letter-spacing: var(--tracking-tight);
    font-weight: 500;
    margin-bottom: 0.75rem;
    max-width: 28ch;
  }
  .manifesto__p {
    color: var(--ink-80);
    max-width: 60ch;
    line-height: 1.55;
  }

  @media (max-width: 720px) {
    .manifesto__item { grid-template-columns: 1fr; gap: 0.5rem; }
    .manifesto__num { font-size: clamp(3rem, 14vw, 5rem); }
  }
</style>
