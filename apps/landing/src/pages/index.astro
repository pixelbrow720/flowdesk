---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import Manifesto from '../components/Manifesto.astro';
import Lenses from '../components/Lenses.astro';
import Exhibit from '../components/Exhibit.astro';
import Honesty from '../components/Honesty.astro';
import Performance from '../components/Performance.astro';
import Founder from '../components/Founder.astro';
import Pricing from '../components/Pricing.astro';
import Access from '../components/Access.astro';
import Footer from '../components/Footer.astro';
---
<Base>
  <Hero />
  <main>
    <Manifesto />
    <Lenses />
    <Exhibit />
    <Honesty />
    <Performance />
    <Founder />
    <Pricing />
    <Access />
  </main>
  <Footer />

  <script>
    // GSAP loaded only when reduced-motion is NOT preferred.
    // Total bundle target ≤100KB gz; gsap core + ScrollTrigger ≈27KB gz.
    if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      import('gsap').then(({ gsap }) => {
        import('gsap/ScrollTrigger').then(({ ScrollTrigger }) => {
          gsap.registerPlugin(ScrollTrigger);

          // Initial state for animated elements
          gsap.set('[data-anim]', { opacity: 0, y: 24 });

          // Hero H1 lines stagger on load
          gsap.to('[data-anim="hero-h1"] .hero__h1-line', {
            opacity: 1, y: 0, duration: 0.8, stagger: 0.12,
            ease: 'power3.out', delay: 0.2,
          });
          gsap.set('[data-anim="hero-h1"]', { opacity: 1 }); // unhide parent

          // Manifesto items pin-fade on scroll
          gsap.utils.toArray<HTMLElement>('[data-anim="manifesto-item"]').forEach((el) => {
            gsap.to(el, {
              opacity: 1, y: 0, duration: 0.7, ease: 'power3.out',
              scrollTrigger: { trigger: el, start: 'top 80%', once: true },
            });
          });

          // Lens cards stagger as the grid enters viewport
          gsap.utils.toArray<HTMLElement>('[data-anim="lens-card"]').forEach((el, i) => {
            gsap.to(el, {
              opacity: 1, y: 0, duration: 0.6, delay: (i % 4) * 0.06, ease: 'power2.out',
              scrollTrigger: { trigger: el, start: 'top 85%', once: true },
            });
          });
        });
      });
    } else {
      // No motion: just reveal everything.
      document.querySelectorAll<HTMLElement>('[data-anim]').forEach((el) => {
        el.style.opacity = '1';
        el.style.transform = 'none';
      });
    }
  </script>
</Base>
