# Normalize line endings: keep LF in the repo, let Git convert on checkout.
# Prevents the CRLF/LF churn that surfaces when the repo is touched on Windows.
* text=auto eol=lf

# Lockfiles & generated artifacts are LF too (avoid spurious diffs).
*.lock text eol=lf
pnpm-lock.yaml text eol=lf
package-lock.json text eol=lf

# Windows-native scripts keep CRLF.
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary assets — never normalize.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.woff binary
*.woff2 binary
*.dbn binary
*.zst binary
